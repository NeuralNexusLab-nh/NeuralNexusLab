# Express server port
PORT=3000

# IPinfo Lite API token: https://ipinfo.io/developers
TOKEN=replace_with_your_ipinfo_token

# App-level memory and request-queue safeguards.
# MAX_RSS_MB is intentionally below 100 MB to leave room for Node runtime overhead.
MAX_RSS_MB=96
MAX_CONCURRENT_REQUESTS=1
MAX_QUEUE_SIZE=100
QUEUE_TIMEOUT_MS=30000
